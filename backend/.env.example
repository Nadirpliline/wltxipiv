# Mandate backend configuration (all optional — sane defaults ship in code).
# Copy to .env to override.

# Persistence: SQLite by default. For Postgres:
# MANDATE_DATABASE_URL=postgresql+psycopg://mandate:mandate@localhost:5432/mandate
MANDATE_DATABASE_URL=sqlite:///./data/mandate.db

# Integration mode: sandbox (deterministic, no keys) or live.
MANDATE_INTEGRATION_MODE=sandbox

# Agent planner: deterministic (default), anthropic, or openai.
MANDATE_LLM_PROVIDER=deterministic
# MANDATE_ANTHROPIC_API_KEY=sk-ant-...
# MANDATE_OPENAI_API_KEY=sk-...
# MANDATE_LLM_MODEL=claude-sonnet-4

# Live integration keys (only needed when MANDATE_INTEGRATION_MODE=live):
# MANDATE_BRIDGE_API_KEY=...

# CORS (comma-separated). Use * to allow all.
MANDATE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Seed demo data on startup (1=yes, 0=no).
MANDATE_SEED=1
